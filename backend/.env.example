# Backend environment (NestJS + Prisma + PostgreSQL)
# Copy to .env and adjust as needed. Git ignores the .env file.

# PostgreSQL connection (docker compose up -d db)
DATABASE_URL="postgresql://app:app@localhost:5432/app?schema=public"

# API HTTP port
PORT=3001

# Allowed CORS origin for the development PWA
WEB_ORIGIN="http://localhost:5173"
