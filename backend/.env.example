# Ambiente do backend (NestJS + Prisma + PostgreSQL)
# Copiar para .env e ajustar. O .env não é versionado.

# Ligação ao PostgreSQL (docker compose up -d db)
DATABASE_URL="postgresql://app:app@localhost:5432/app?schema=public"

# Porta do servidor HTTP da API
PORT=3001

# Origem permitida para CORS (PWA em desenvolvimento)
WEB_ORIGIN="http://localhost:5173"
